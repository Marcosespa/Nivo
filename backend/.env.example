# Nivo — Variables de entorno (copiar a .env y completar)
# NUNCA hacer commit del archivo .env

# Entorno
ENVIRONMENT=development
DEBUG=true

# Base de datos
DATABASE_URL=postgresql+asyncpg://Nivo:Nivo@localhost:5432/Nivo_dev

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — CAMBIAR en producción (mínimo 32 caracteres)
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_MINIMUM_32_CHARS

# PQC
PQC_ALGORITHM=ML-KEM-768
HYBRID_MODE=true
PQC_SECURITY_LEVEL=3

# Pasarela de pagos (Wompi)
PAYMENT_GATEWAY=wompi
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_SECRET=

# KYC (Truora)
KYC_API_KEY=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Firebase (Push notifications)
FIREBASE_CREDENTIALS_PATH=

# GCP
GCP_PROJECT_ID=Nivo-dev
