                "exec": [
                  "const msg = 'Pago Nivo: $50.000 COP → +573009876543 | ' + new Date().toISOString();",
                  "let hex = '';",
                  "for (let i = 0; i < msg.length; i++) {",
                  "    hex += ('0' + msg.charCodeAt(i).toString(16)).slice(-2);",
                  "}",
                  "pm.collectionVariables.set('signed_data_hex', hex);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Firma generada con ML-DSA-65', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.algorithm).to.equal('ML-DSA-65');",
                  "    pm.collectionVariables.set('pqc_signature_hex',  json.signature_hex);",
                  "    pm.collectionVariables.set('pqc_public_key_hex', json.public_key_hex);",
                  "    console.log('🔐 Firma guardada. Longitud:', json.signature_hex.length, 'chars hex');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
